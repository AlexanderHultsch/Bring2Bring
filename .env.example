# This file is a template. The real .env is gitignored and never committed.
# On the Raspberry Pi, SESSION_SECRET / ADMIN_USER / ADMIN_PASSWORD are
# written automatically by the host's scripts/deploy.sh; PUBLIC_BASE_URL is
# supplied by the compose file.

# HTTP listen port.
PORT=3000

# SQLite database file path.
DB_PATH=./data/bring2bring.db

# Directory for uploaded recipe images.
UPLOAD_DIR=./data/uploads

# Session cookie signing key. Required, at least 16 characters.
SESSION_SECRET=<<CHANGE_ME>>

# Admin login name, used by `npm run seed:admin`. Required.
ADMIN_USER=<<CHANGE_ME>>

# Admin password, used by `npm run seed:admin`. Required.
ADMIN_PASSWORD=<<CHANGE_ME>>

# Absolute base URL the app is reachable at, used to build share links for Bring!. Required.
PUBLIC_BASE_URL=https://dishlist.example.com

# Number of proxy hops to trust (Caddy + cloudflared) for Express `trust proxy`.
TRUST_PROXY=1

# Node environment: production, development, or test.
NODE_ENV=production

# Locale used for number/quantity formatting.
NUMBER_LOCALE=de-DE
