<header class="site-header">
  <div class="site-header__start">
    <% if (typeof backHref !== 'undefined' && backHref) { %>
      <a class="site-header__back" href="<%= backHref %>" aria-label="Back">
        <svg class="icon"><use href="#i-back"></use></svg>
      </a>
    <% } %>
    <a class="site-header__brand" href="/">Bring2Bring!</a>
  </div>
  <div class="site-header__actions">
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between light and dark">
      <svg class="icon theme-toggle__sun"><use href="#i-sun"></use></svg>
      <svg class="icon theme-toggle__moon"><use href="#i-moon"></use></svg>
    </button>
    <% if (currentUser) { %>
      <%- include('menu', { csrfToken }) %>
    <% } %>
  </div>
</header>
