<header class="site-header">
  <div class="site-header__start">
    <% if (typeof backHref !== 'undefined' && backHref) { %>
      <a class="site-header__back" href="<%= backHref %>" aria-label="Back">
        <svg class="icon"><use href="#i-back"></use></svg>
      </a>
    <% } %>
    <% if (typeof pageTitle !== 'undefined' && pageTitle) { %>
      <span class="site-header__title"><%= pageTitle %></span>
    <% } else { %>
      <a class="site-header__brand" href="/">Dishlist</a>
    <% } %>
  </div>
  <div class="site-header__actions">
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">🌓</button>
    <% if (currentUser) { %>
      <%- include('menu', { csrfToken }) %>
    <% } %>
  </div>
</header>
