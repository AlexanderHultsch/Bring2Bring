<%
  // SPECIFICATION.md section 10.1/10.E: always all 27 entries ('#' then
  // A-Z), so the rail never reflows as the list is filtered. A letter with
  // no recipes renders inert (not a link) rather than being left out.
  const azLetters = ['#', ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))];
  const activeLetters = new Set(groups.map((group) => group.letter));
%>
<nav class="az-rail" aria-label="Jump to letter">
  <% azLetters.forEach((letter) => { %>
    <% if (activeLetters.has(letter)) { %>
      <a class="az-rail__letter" href="#sect-<%= letter %>"><%= letter %></a>
    <% } else { %>
      <span class="az-rail__letter az-rail__letter--inert" aria-hidden="true"><%= letter %></span>
    <% } %>
  <% }) %>
</nav>
