<%
  function publicUrl(overrides) {
    const state = Object.assign({ search, sort }, overrides);
    const params = new URLSearchParams();
    if (state.search) params.set('q', state.search);
    params.set('sort', state.sort);
    const query = params.toString();
    return query ? '/public?' + query : '/public';
  }
  const showAZ = sort === 'title';
%>
<%- include('../partials/head', { title: 'Public — Bring2Bring!' }) %>
      <%- include('../partials/header', { currentUser, csrfToken }) %>
      <% if (showAZ) { %><%- include('../partials/az-rail', { groups }) %><% } %>
      <main class="recipes-page has-bottom-nav<%= showAZ ? ' recipes-page--az' : '' %>">
        <div class="recipes-page__bar">
          <h1>Public</h1>
        </div>

        <form method="get" action="/public" class="list-controls" role="search">
          <input type="hidden" name="sort" value="<%= sort %>">
          <label class="visually-hidden" for="q">Search recipes</label>
          <div class="search-field">
            <svg class="icon search-field__icon"><use href="#i-search"></use></svg>
            <input type="search" id="q" name="q" value="<%= search %>" placeholder="Search recipes">
          </div>
          <button type="submit" class="visually-hidden">Search</button>
        </form>

        <nav class="segmented" aria-label="Sort recipes">
          <a class="segmented__item<%= sort === 'title' ? ' segmented__item--on' : '' %>" href="<%= publicUrl({ sort: 'title' }) %>"<% if (sort === 'title') { %> aria-current="true"<% } %>>A–Z</a>
          <a class="segmented__item<%= sort === 'imports' ? ' segmented__item--on' : '' %>" href="<%= publicUrl({ sort: 'imports' }) %>"<% if (sort === 'imports') { %> aria-current="true"<% } %>>Most imported</a>
          <a class="segmented__item<%= sort === 'recent' ? ' segmented__item--on' : '' %>" href="<%= publicUrl({ sort: 'recent' }) %>"<% if (sort === 'recent') { %> aria-current="true"<% } %>>Newest</a>
        </nav>

        <% const hasActiveFilter = search.trim() !== ''; %>
        <% if (recipes.length === 0) { %>
          <p class="empty-state">
            <% if (hasActiveFilter) { %>
              No public recipes match your search. <a href="/public">Clear filters</a>.
            <% } else { %>
              Public recipes from any Bring2Bring! user appear here once someone publishes one. Nobody has published a recipe yet.
            <% } %>
          </p>
        <% } else if (showAZ) { %>
          <% groups.forEach((group) => { %>
            <h2 class="recipe-list__section" id="sect-<%= group.letter %>"><%= group.letter %></h2>
            <ul class="recipe-list">
              <% group.recipes.forEach((recipe) => { %>
                <%- include('../partials/recipe-list-row', { recipe, showAuthor: true }) %>
              <% }) %>
            </ul>
          <% }) %>
        <% } else { %>
          <ul class="recipe-list">
            <% recipes.forEach((recipe) => { %>
              <%- include('../partials/recipe-list-row', { recipe, showAuthor: true }) %>
            <% }) %>
          </ul>
        <% } %>
      </main>
      <%- include('../partials/bottom-nav', { activeNav: 'public' }) %>
<%- include('../partials/foot') %>
