<%- include('../partials/head', { title: 'Public — Dishlist' }) %>
      <%- include('../partials/header', { currentUser, csrfToken }) %>
      <main class="recipes-page has-bottom-nav">
        <div class="recipes-page__bar">
          <h1>Public</h1>
        </div>

        <form method="get" action="/public" class="list-controls" role="search">
          <div class="list-controls__search">
            <label for="q">Search</label>
            <input type="search" id="q" name="q" value="<%= search %>" placeholder="Search title or ingredient">
          </div>
          <div class="list-controls__sort">
            <label for="sort">Sort</label>
            <select id="sort" name="sort">
              <option value="title" <%= sort === 'title' ? 'selected' : '' %>>A-Z</option>
              <option value="imports" <%= sort === 'imports' ? 'selected' : '' %>>Most imported</option>
              <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>>Recently added</option>
            </select>
          </div>
          <button type="submit" class="button">Apply</button>
        </form>

        <% const hasActiveFilter = search.trim() !== ''; %>
        <% if (recipes.length === 0) { %>
          <p class="empty-state">
            <% if (hasActiveFilter) { %>
              No public dishes match your search. <a href="/public">Clear filters</a>.
            <% } else { %>
              Public dishes from any Dishlist user appear here once someone publishes one. Nobody has published a dish yet.
            <% } %>
          </p>
        <% } else { %>
          <ul class="recipe-list">
            <% recipes.forEach((recipe) => { %>
              <li class="recipe-list__item">
                <a class="recipe-list__link" href="/recipes/<%= recipe.id %>">
                  <span class="recipe-list__title"><%= recipe.title %></span>
                  <span class="recipe-list__meta">
                    @<%= recipe.author_username %>
                    · <svg class="icon"><use href="#i-bring"></use></svg> <%= recipe.bring_import_count %>
                  </span>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </main>
      <%- include('../partials/bottom-nav', { activeNav: 'public' }) %>
<%- include('../partials/foot') %>
