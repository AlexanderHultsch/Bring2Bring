<%- include('../partials/head', { title: recipe.title + ' — Dishlist' }) %>
      <%- include('../partials/header', { currentUser, csrfToken, backHref: '/', pageTitle: recipe.title }) %>
      <main class="recipe-page has-bottom-nav" data-recipe-id="<%= recipe.id %>" data-saved="<%= saved %>">
        <% if (recipe.is_archived) { %>
          <p class="recipe-page__archived-flag">Archived</p>
        <% } %>
        <h1><%= recipe.title %></h1>

        <section class="servings-section">
          <h2>Servings</h2>
          <%
            // Progressive enhancement (section 7.4, v2.0 D6): each number is a
            // real ?yield=N href, computed from the server-rendered
            // requestedYield, so the wheel works with JavaScript disabled;
            // recipe-view.js intercepts the tap and recalculates without a
            // reload.
          %>
          <div class="servings-wheel" data-yield-wheel role="list" aria-label="Servings">
            <% for (let n = 1; n <= 10; n++) { %>
              <a
                class="servings-wheel__item<%= n === requestedYield ? ' servings-wheel__item--selected' : '' %>"
                href="?yield=<%= n %>"
                data-yield-option="<%= n %>"
                role="listitem"
                <% if (n === requestedYield) { %>aria-current="true"<% } %>
              ><%= n %></a>
            <% } %>
          </div>
        </section>

        <section class="recipe-ingredients" data-base-yield="<%= recipe.yield_amount %>" data-locale="<%= locale %>">
          <h2>Ingredients (for <span data-servings-count><%= requestedYield %></span> servings)</h2>
          <ul class="ingredient-list" data-ingredient-list>
            <% groups[0].ingredients.forEach((ingredient, ingredientIndex) => {
                 const scaledIngredient = scaledGroups[0].ingredients[ingredientIndex];
            %>
              <li
                class="ingredient-list__item"
                data-ingredient
                data-amount="<%= ingredient.amount != null ? ingredient.amount : '' %>"
                data-unit="<%= ingredient.unit || '' %>"
                data-name="<%= ingredient.name || '' %>"
                data-scales="1"
              >
                <% if (scaledIngredient.amountText != null) { %>
                  <span class="ingredient-list__amount" data-amount-display<% if (scaledIngredient.exactText) { %> title="<%= scaledIngredient.exactText %>"<% } %>><%= scaledIngredient.amountText %></span>
                <% } %>
                <span class="ingredient-list__name"><%= ingredient.name %></span>
              </li>
            <% }) %>
          </ul>
        </section>

        <div class="recipe-primary-action">
          <% if (recipe.share_enabled) { %>
            <a class="button button--bring" href="/recipes/<%= recipe.id %>/bring?yield=<%= requestedYield %>" data-bring-link>
              <svg class="icon"><use href="#i-bring"></use></svg>
              Send to Bring!
            </a>
          <% } else { %>
            <form method="post" action="/recipes/<%= recipe.id %>/share/link" class="bring-action">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="action" value="enable">
              <p class="bring-action__hint">Bring! needs to fetch this recipe itself, so sending to Bring! requires a public link.</p>
              <button type="submit" class="button button--bring">
                <svg class="icon"><use href="#i-bring"></use></svg>
                Enable public link and send to Bring!
              </button>
            </form>
          <% } %>
        </div>

        <details class="public-link">
          <summary class="public-link__summary">
            <span class="public-link__summary-label">
              <svg class="icon"><use href="#i-globe"></use></svg>
              Public link · <%= recipe.share_enabled ? 'on' : 'off' %>
            </span>
            <svg class="icon public-link__chevron public-link__chevron--closed"><use href="#i-chevron-right"></use></svg>
            <svg class="icon public-link__chevron public-link__chevron--open"><use href="#i-chevron-up"></use></svg>
          </summary>
          <div class="public-link__content">
            <% if (recipe.share_enabled) { %>
              <%
                const shareUrl = publicBaseUrl + '/r/' + recipe.share_token;
              %>
              <p class="share-panel__url" data-share-url><%= shareUrl %></p>
              <div class="share-panel__actions">
                <button type="button" class="button button--ghost" data-copy-share-link data-share-url="<%= shareUrl %>">
                  <svg class="icon"><use href="#i-copy"></use></svg>
                  Copy
                </button>
                <form method="post" action="/recipes/<%= recipe.id %>/share/link" class="share-panel__form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="rotate">
                  <button type="submit" class="button button--ghost">
                    <svg class="icon"><use href="#i-rotate"></use></svg>
                    Rotate
                  </button>
                </form>
                <form method="post" action="/recipes/<%= recipe.id %>/share/link" class="share-panel__form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="action" value="disable">
                  <button type="submit" class="button button--danger">
                    <svg class="icon"><use href="#i-disable"></use></svg>
                    Disable
                  </button>
                </form>
              </div>
              <p class="share-panel__warning">Rotating replaces this link immediately — previously imported Bring! entries will no longer link back.</p>
            <% } else { %>
              <p class="share-panel__hint">Sharing is off. Enable it to get a public link Bring! can import.</p>
              <form method="post" action="/recipes/<%= recipe.id %>/share/link" class="share-panel__form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="enable">
                <button type="submit" class="button">Enable public link</button>
              </form>
            <% } %>
          </div>
        </details>

        <script src="/js/copy-share-link.js" defer></script>

        <% if (steps.length > 0) { %>
          <section class="recipe-method">
            <h2>Method</h2>
            <p class="recipe-method__text"><%= steps[0].text %></p>
          </section>
        <% } %>

        <div class="recipe-actions">
          <a class="button button--ghost" href="/recipes/<%= recipe.id %>/edit">Edit</a>
          <form method="post" action="/recipes/<%= recipe.id %>/duplicate" class="recipe-actions__form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="button button--ghost">Duplicate</button>
          </form>
          <form method="post" action="/recipes/<%= recipe.id %>/delete" class="recipe-actions__form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="button button--danger">
              <%= recipe.is_archived ? 'Delete permanently' : 'Archive' %>
            </button>
          </form>
        </div>
      </main>
      <%- include('../partials/bottom-nav', { activeNav: null }) %>
<%- include('../partials/foot') %>
