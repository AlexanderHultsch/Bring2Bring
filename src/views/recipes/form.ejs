<%- include('../partials/head', { title: (mode === 'edit' ? 'Edit recipe' : 'New recipe') + ' — Dishlist' }) %>
      <%- include('../partials/header', {
        currentUser,
        csrfToken,
        backHref: mode === 'edit' ? '/recipes/' + recipeId : '/',
        pageTitle: mode === 'edit' ? 'Edit recipe' : 'New recipe',
      }) %>
      <main class="editor-page has-bottom-nav">
        <h1><%= mode === 'edit' ? 'Edit recipe' : 'New recipe' %></h1>

        <% if (errors.length > 0) { %>
          <ul class="form-errors">
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        <% } %>

        <form
          method="post"
          action="<%= mode === 'edit' ? '/recipes/' + recipeId : '/recipes' %>"
          class="recipe-form"
          data-recipe-editor
          data-recipe-id="<%= mode === 'edit' ? recipeId : 'new' %>"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <label for="title">Title</label>
          <input type="text" id="title" name="title" value="<%= values.title %>" required maxlength="200">

          <label for="servings">Servings</label>
          <input type="text" inputmode="decimal" id="servings" name="servings" value="<%= values.servings %>" required>

          <h2>Ingredients</h2>
          <div class="ingredient-rows" data-ingredients>
            <% values.ingredients.forEach((ingredient, ingredientIndex) => { %>
              <div class="ingredient-row" data-ingredient>
                <input type="text" inputmode="decimal" name="ingredients[<%= ingredientIndex %>][amount]" value="<%= ingredient.amount %>" placeholder="Amount" class="ingredient-row__amount">
                <select name="ingredients[<%= ingredientIndex %>][unit]" class="ingredient-row__unit">
                  <% EDITOR_UNITS.forEach((unit) => { %>
                    <option value="<%= unit.key %>" <%= ingredient.unit === unit.key ? 'selected' : '' %>><%= unit.label %></option>
                  <% }) %>
                </select>
                <input type="text" name="ingredients[<%= ingredientIndex %>][name]" value="<%= ingredient.name %>" placeholder="Ingredient" class="ingredient-row__name" data-ingredient-name>
                <div class="ingredient-row__actions">
                  <button type="button" data-remove-ingredient>Remove</button>
                </div>
              </div>
            <% }) %>
          </div>
          <button type="button" class="button button--ghost" data-add-ingredient>Add ingredient</button>

          <h2>Method</h2>
          <label for="method">Method (optional)</label>
          <textarea id="method" name="method" data-method><%= values.method %></textarea>

          <button type="submit" class="button">Save recipe</button>

          <template data-ingredient-row-template>
            <div class="ingredient-row" data-ingredient>
              <input type="text" inputmode="decimal" name="" value="" placeholder="Amount" class="ingredient-row__amount">
              <select name="" class="ingredient-row__unit">
                <% EDITOR_UNITS.forEach((unit) => { %>
                  <option value="<%= unit.key %>"><%= unit.label %></option>
                <% }) %>
              </select>
              <input type="text" name="" value="" placeholder="Ingredient" class="ingredient-row__name" data-ingredient-name>
              <div class="ingredient-row__actions">
                <button type="button" data-remove-ingredient>Remove</button>
              </div>
            </div>
          </template>
        </form>
      </main>
      <%- include('../partials/bottom-nav', { activeNav: mode === 'new' ? 'new' : null }) %>
      <script src="/js/recipe-editor.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/foot') %>
