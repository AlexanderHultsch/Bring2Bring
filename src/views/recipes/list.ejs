<%- include('../partials/head', { title: (archived ? 'Archive' : 'Recipes') + ' — Dishlist' }) %>
      <%- include('../partials/header', { currentUser, csrfToken }) %>
      <main class="recipes-page">
        <p class="recipes-page__greeting">Signed in as <%= currentUser.username %></p>
        <div class="recipes-page__bar">
          <h1><%= archived ? 'Archive' : 'Recipes' %></h1>
          <a class="button button--ghost" href="<%= archived ? '/' : '/?archived=1' %>">
            <%= archived ? 'Back to recipes' : 'View archive' %>
          </a>
        </div>

        <form method="get" action="/" class="list-controls" role="search">
          <% if (archived) { %><input type="hidden" name="archived" value="1"><% } %>
          <% selectedTagIds.forEach((tagId) => { %>
            <input type="hidden" name="tag" value="<%= tagId %>">
          <% }) %>
          <div class="list-controls__search">
            <label for="q">Search</label>
            <input type="search" id="q" name="q" value="<%= search %>" placeholder="Search title, ingredient or tag">
          </div>
          <div class="list-controls__sort">
            <label for="sort">Sort</label>
            <select id="sort" name="sort">
              <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>>Recently added</option>
              <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title</option>
              <option value="updated" <%= sort === 'updated' ? 'selected' : '' %>>Last updated</option>
            </select>
          </div>
          <button type="submit" class="button">Apply</button>
        </form>

        <% if (tags.length > 0) { %>
          <ul class="tag-chips">
            <% tags.forEach((tag) => {
                 const isSelected = selectedTagIds.includes(tag.id);
                 const nextTagIds = isSelected
                   ? selectedTagIds.filter((id) => id !== tag.id)
                   : selectedTagIds.concat(tag.id);
                 const params = new URLSearchParams();
                 if (search) params.set('q', search);
                 if (sort !== 'recent') params.set('sort', sort);
                 if (archived) params.set('archived', '1');
                 nextTagIds.forEach((id) => params.append('tag', id));
                 const chipHref = '/?' + params.toString();
            %>
              <li>
                <a
                  class="tag-chip <%= isSelected ? 'tag-chip--selected' : '' %>"
                  href="<%= chipHref %>"
                  aria-pressed="<%= isSelected ? 'true' : 'false' %>"
                ><%= tag.name %></a>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <% const hasActiveFilter = search.trim() !== '' || selectedTagIds.length > 0; %>
        <% if (recipes.length === 0) { %>
          <p class="empty-state">
            <% if (hasActiveFilter) { %>
              No recipes match your search. <a href="/<%= archived ? '?archived=1' : '' %>">Clear filters</a>.
            <% } else if (archived) { %>
              No archived recipes.
            <% } else { %>
              No recipes yet. <a href="/recipes/new">Add your first recipe</a>.
            <% } %>
          </p>
        <% } else { %>
          <ul class="recipe-list">
            <% recipes.forEach((recipe) => { %>
              <li class="recipe-list__item">
                <a class="recipe-list__link" href="/recipes/<%= recipe.id %>">
                  <span class="recipe-list__title"><%= recipe.title %></span>
                  <span class="recipe-list__meta">
                    <% if (recipe.total_minutes != null) { %><%= recipe.total_minutes %> min · <% } %><%= recipe.yield_amount %> <%= recipe.yield_label || recipe.yield_unit %>
                  </span>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <p><a class="button" href="/recipes/new">New recipe</a></p>
      </main>
<%- include('../partials/foot') %>
