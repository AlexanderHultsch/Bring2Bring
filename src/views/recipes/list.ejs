<%
  function listUrl(overrides) {
    const state = Object.assign({ search, sort, archived, matchIngredients }, overrides);
    const params = new URLSearchParams();
    if (state.search) params.set('q', state.search);
    params.set('sort', state.sort);
    if (state.matchIngredients) params.set('ingredients', '1');
    if (state.archived) params.set('archived', '1');
    const query = params.toString();
    return query ? '/?' + query : '/';
  }
  const showAZ = sort === 'title';
%>
<%- include('../partials/head', { title: (archived ? 'Archive' : 'Recipes') + ' — Dishlist' }) %>
      <%- include('../partials/header', { currentUser, csrfToken, backHref: archived ? '/' : undefined }) %>
      <% if (showAZ) { %><%- include('../partials/az-rail', { groups }) %><% } %>
      <main class="recipes-page has-bottom-nav<%= showAZ ? ' recipes-page--az' : '' %>">
        <h1><%= archived ? 'Archive' : 'Recipes' %></h1>

        <form method="get" action="/" class="list-controls" role="search">
          <% if (archived) { %><input type="hidden" name="archived" value="1"><% } %>
          <% if (matchIngredients) { %><input type="hidden" name="ingredients" value="1"><% } %>
          <input type="hidden" name="sort" value="<%= sort %>">
          <label class="visually-hidden" for="q">Search recipes</label>
          <div class="search-field">
            <svg class="icon search-field__icon"><use href="#i-search"></use></svg>
            <input type="search" id="q" name="q" value="<%= search %>" placeholder="Search recipes">
          </div>
          <button type="submit" class="visually-hidden">Search</button>
        </form>
        <a class="ingredients-toggle<%= matchIngredients ? ' ingredients-toggle--on' : '' %>" href="<%= listUrl({ matchIngredients: !matchIngredients }) %>">
          <span class="ingredients-toggle__track" aria-hidden="true"></span>
          <span class="ingredients-toggle__label">Also search ingredients</span>
        </a>

        <% const hasActiveFilter = search.trim() !== ''; %>
        <% if (recipes.length === 0) { %>
          <p class="empty-state">
            <% if (hasActiveFilter) { %>
              No recipes match your search. <a href="/<%= archived ? '?archived=1' : '' %>">Clear filters</a>.
            <% } else if (archived) { %>
              No archived recipes.
            <% } else { %>
              No recipes yet. <a href="/recipes/new">Add your first recipe</a>.
            <% } %>
          </p>
        <% } else if (showAZ) { %>
          <% groups.forEach((group) => { %>
            <h2 class="recipe-list__section" id="sect-<%= group.letter %>"><%= group.letter %></h2>
            <ul class="recipe-list">
              <% group.recipes.forEach((recipe) => { %>
                <%- include('../partials/recipe-list-row', { recipe, showAuthor: false }) %>
              <% }) %>
            </ul>
          <% }) %>
        <% } else { %>
          <ul class="recipe-list">
            <% recipes.forEach((recipe) => { %>
              <%- include('../partials/recipe-list-row', { recipe, showAuthor: false }) %>
            <% }) %>
          </ul>
        <% } %>
      </main>
      <%- include('../partials/bottom-nav', { activeNav: archived ? null : 'mine' }) %>
<%- include('../partials/foot') %>
