<%- include('partials/head', { title: 'Account — Bring2Bring!' }) %>
      <%- include('partials/header', { currentUser, csrfToken, backHref: '/' }) %>
      <main class="account-page has-bottom-nav">
        <h1>Account</h1>
        <dl class="account-details">
          <dt>Username</dt>
          <dd><%= currentUser.username %></dd>
          <dt>Role</dt>
          <dd><%= currentUser.role %></dd>
          <dt>Member since</dt>
          <dd><%= memberSince %></dd>
        </dl>

        <% if (unitsSaved) { %>
          <p class="form-success">Units saved.</p>
        <% } %>
        <% if (unitsError) { %>
          <p class="form-error"><%= unitsError %></p>
        <% } %>

        <h2>Ingredient units</h2>
        <form method="post" action="/account/units" class="auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="unitLanguage">Label language</label>
          <select id="unitLanguage" name="unitLanguage">
            <option value="de" <%= currentUser.unit_language === 'de' ? 'selected' : '' %>>Deutsch (TL, EL, Prise, Stück)</option>
            <option value="en" <%= currentUser.unit_language === 'en' ? 'selected' : '' %>>English (tsp, tbsp, pinch, pcs)</option>
          </select>
          <label for="measurementSystem">Measurement system</label>
          <select id="measurementSystem" name="measurementSystem">
            <option value="metric" <%= currentUser.measurement_system === 'metric' ? 'selected' : '' %>>Metric (g, kg, ml, l)</option>
            <option value="imperial" <%= currentUser.measurement_system === 'imperial' ? 'selected' : '' %>>Imperial (oz, lb, fl oz, qt)</option>
          </select>
          <button type="submit" class="button">Save units</button>
        </form>
        <p class="field-hint">Changes how quantities are displayed. Recipes are always entered and stored in metric.</p>

        <% if (passwordChanged) { %>
          <p class="form-success">Password changed.</p>
        <% } %>
        <% if (passwordError) { %>
          <p class="form-error"><%= passwordError %></p>
        <% } %>

        <h2>Change password</h2>
        <form method="post" action="/account/password" class="auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="currentPassword">Current password</label>
          <input
            type="password"
            id="currentPassword"
            name="currentPassword"
            autocomplete="current-password"
            required
          >
          <label for="newPassword">New password</label>
          <input
            type="password"
            id="newPassword"
            name="newPassword"
            autocomplete="new-password"
            minlength="12"
            required
          >
          <label for="confirmPassword">Confirm new password</label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            autocomplete="new-password"
            minlength="12"
            required
          >
          <button type="submit" class="button">Change password</button>
        </form>
      </main>
      <%- include('partials/bottom-nav', { activeNav: null }) %>
<%- include('partials/foot') %>
